# ============================================================
#  Configuración de "letras para mi creador"
#  Copia este archivo como .env y llena los datos.
#  (.env NUNCA se sube a GitHub; este .env.example sí, porque no tiene claves)
# ============================================================

# 1) En MongoDB Atlas: botón "Connect" > "Drivers" > copia la cadena
#    y pégala aquí. Deja <db_password> tal cual, NO lo borres.
MONGODB_URI=mongodb+srv://USUARIO:<db_password>@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# 2) Escribe aquí SOLO la contraseña del usuario de la base de datos
MONGODB_PASSWORD=

# Nombre de la base de datos (puedes dejarlo así)
MONGODB_DB=letras

# Contraseña para entrar al modo creador (Ctrl+Shift+E)
ADMIN_PASSWORD=

# (opcional) Si lo llenas, para entrar al modo creador también se pide este correo
ADMIN_CORREO=

# Clave larga y al azar para firmar la sesión de la creadora
SESSION_SECRET=

# Puerto de la página: http://localhost:3100
PORT=3100

# Tamaño máximo de cada archivo que subes (en MB)
MAX_UPLOAD_MB=50
